<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup Label="Globals">
    <SccProjectName></SccProjectName>
    <SccProvider></SccProvider>
    <SccAuxPath></SccAuxPath>
    <SccLocalPath></SccLocalPath>
    <Platforms>x64;AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Angular-only container project: no C# entry point, so build as a library -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\app\employees\**" />
    <Compile Remove="src\app\reports\**" />
    <Compile Remove="src\app\setup\**" />
    <Compile Remove="src\app\users\**" />
    <Content Remove="src\app\employees\**" />
    <Content Remove="src\app\reports\**" />
    <Content Remove="src\app\setup\**" />
    <Content Remove="src\app\users\**" />
    <EmbeddedResource Remove="src\app\employees\**" />
    <EmbeddedResource Remove="src\app\reports\**" />
    <EmbeddedResource Remove="src\app\setup\**" />
    <EmbeddedResource Remove="src\app\users\**" />
    <None Remove="src\app\employees\**" />
    <None Remove="src\app\reports\**" />
    <None Remove="src\app\setup\**" />
    <None Remove="src\app\users\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

</Project>
