{
  "name": "babesiosis-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm install --legacy-peer-deps && ng serve --host=127.0.0.1 --port 4400 --configuration local",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "deploy:dev": "npm run build:dev && swa deploy dev --env production",
    "deploy:prod": "npm run build:prod && swa deploy prod --env production",
    "deploy:perpetua": "npm run build:prod && swa deploy perpetua --env production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "npm run lint:fs && npm run lint:imports",
    "lint:fs": "node scripts/fs-guard.mjs --all",
    "lint:fs:baseline": "node scripts/fs-guard.mjs --update-baseline",
    "lint:imports": "node scripts/import-guard.mjs --all",
    "hooks:install": "git -C .. config core.hooksPath .githooks",
    "prepare": "git -C .. config core.hooksPath .githooks || true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@fundstream-ai/gnome-ui": "1.0.0-rc.4",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngrx/store": "^22.0.1",
    "@popperjs/core": "^2.11.8",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-text-style": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "apexcharts": "^5.16.0",
    "bootstrap": "^5.3.8",
    "iconify-icon": "^3.0.2",
    "ng-apexcharts": "^2.5.0",
    "ngrx-store-localstorage": "^20.1.0",
    "rxjs": "~7.8.0",
    "simplebar-angular": "^3.3.2",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "write-excel-file": "^2.3.10",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@azure/static-web-apps-cli": "^2.0.10",
    "@types/jasmine": "~5.1.0",
    "@types/uuid": "^10.0.0",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "^9.39.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
