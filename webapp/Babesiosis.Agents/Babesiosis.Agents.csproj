<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.27.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Babesiosis.Core\Babesiosis.Core.csproj" />
  </ItemGroup>

  <!--
    The clinical manual: the page files that the web app's Clinical screen draws
    (format: /clinical/content-format.md). They are embedded so that the agent's clinical tools
    read the same pages in every deployment. Rebuild this project after a page changes.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Babesiosis.Web\public\assets\clinical\*.json"
                      Link="Clinical\Pages\%(Filename)%(Extension)"
                      LogicalName="Babesiosis.Agents.Clinical.Pages.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
