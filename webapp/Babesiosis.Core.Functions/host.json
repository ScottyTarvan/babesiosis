{
  "version": "2.0",
  "functionTimeout": "-1",
  "logging": {
    "logLevel": {
      "Babesiosis": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensions": {
    "serviceBus": {
      "autoCompleteMessages": true,
      "maxAutoLockRenewalDuration": "00:30:00",
      "maxConcurrentSessions": 8,
      "maxConcurrentCallsPerSession": 1,
      "sessionIdleTimeout": "00:01:00",
      "prefetchCount": 0
    }
  }
}
