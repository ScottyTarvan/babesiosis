<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Babesiosis.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Databricks\**" />
    <Compile Remove="Datasets\Models\**" />
    <Compile Remove="Models\Facts\**" />
    <EmbeddedResource Remove="Databricks\**" />
    <EmbeddedResource Remove="Datasets\Models\**" />
    <EmbeddedResource Remove="Models\Facts\**" />
    <None Remove="Databricks\**" />
    <None Remove="Datasets\Models\**" />
    <None Remove="Models\Facts\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Datasets\Services\IManageDatasetService.cs" />
    <Compile Remove="Datasets\Services\Impl\ManageDatasetService.cs" />
    <Compile Remove="Datasets\Services\Providers\ManageDatasetServiceProvider.cs" />
    <Compile Remove="ViewModels\NameDescriptionViewModel.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Configurations\debug-appsettings.json" Link="debug-appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Azure.Storage.Blobs.Batch" Version="12.26.1" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="DevExtreme.AspNet.Data" Version="5.1.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos.Table" Version="1.0.8" />
    <PackageReference Include="Microsoft.Azure.ServiceBus" Version="5.2.0" />
    <PackageReference Include="Microsoft.Azure.WebJobs" Version="3.0.47" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.6.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <!-- NPOI's transitive SkiaSharp never reaches consumer outputs, which breaks
         AutoSizeColumn at runtime (SheetUtil.GetDefaultCharWidth). Referencing it
         directly makes the managed + native assets flow to every consumer. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="WindowsAzure.Storage" Version="9.3.3" />
    <!-- Pinned explicitly: EF Core SqlServer 10.0.12 only drags in 6.1.6, but every
         consumer resolves 7.0.0, which moved SqlAuthenticationMethod out into
         Microsoft.Data.SqlClient.Extensions.Abstractions. Compiling against 6.1.6 bakes
         the old get_Authentication() signature in and throws MissingMethodException at
         runtime. Keep this in step with Babesiosis.DataFactory.SqlServer. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Babesiosis.Core.Test" />
  </ItemGroup>
</Project>